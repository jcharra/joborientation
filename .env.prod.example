# Copy to .env next to docker-compose.prod.yml on the server (gitignored, never commit the real values).
# docker compose -f docker-compose.prod.yml automatically loads a sibling .env file.

# --- Traefik wiring ---
DOMAIN=joborientation.example.com
TRAEFIK_NETWORK_NAME=traefik                # external network name from your Traefik project's compose file
TRAEFIK_CERTRESOLVER=letsencrypt            # certresolver name configured in your Traefik project

# --- App ---
APP_KEY=                                    # fill in after first run: docker compose -f docker-compose.prod.yml run --rm app php artisan key:generate --show
DB_PASSWORD=

# --- Mail (real SMTP provider — mailcatcher is dev-only) ---
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@example.com

# --- LDAP (only needed if ldap_students / ldap_consultants is turned on via AppSetting) ---
LDAP_HOST=
LDAP_USERNAME=
LDAP_PASSWORD=
LDAP_BASE_DN=
LDAP_PORT=
